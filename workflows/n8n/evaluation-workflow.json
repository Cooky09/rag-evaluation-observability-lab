    {
      "parameters": {
        "jsCode": "const output = $json.stdout;\n\nfunction extract(pattern) {\n  const match = output.match(pattern);\n  return match ? Number(match[1]) : null;\n}\n\nconst averageRecall = extract(\n  /Average retrieval recall:\\s*([0-9.]+)/\n);\n\nconst answerSimilarity = extract(\n  /Average answer similarity:\\s*([0-9.]+)/\n);\n\nconst factCoverage = extract(\n  /Average fact coverage:\\s*([0-9.]+)/\n);\n\nconst groundedRate = extract(\n  /Grounded rate:\\s*([0-9.]+)/\n);\n\nconst bestThroughput = extract(\n  /Best throughput:\\s*([0-9.]+)\\s*samples\\/sec/\n);\n\nconst lowestLatency = extract(\n  /Lowest latency:\\s*([0-9.]+)\\s*ms/\n);\n\nreturn [\n  {\n    json: {\n      status: $json.status,\n      exit_code: $json.exit_code,\n      average_retrieval_recall: averageRecall,\n      average_answer_similarity: answerSimilarity,\n      average_fact_coverage: factCoverage,\n      grounded_rate: groundedRate,\n      best_throughput_samples_per_sec: bestThroughput,\n      lowest_latency_ms: lowestLatency,\n    },\n  },\n];"
      },
